{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeTune",
  "version": "0.1.0",
  "identifier": "com.bizkitman.freetune",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"title":"FreeTune","width":1100,"height":720,"resizable":true}],
    "security": {"csp":null}
  },
  "bundle": {"active":true,"targets":["dmg","nsis"],"icon":[]}
}
